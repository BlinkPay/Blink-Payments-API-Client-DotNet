<Project>

  <PropertyGroup>
    <!--
      Pinned rather than left to default from the target framework, so moving to a newer
      target framework does not also change the language version as a side effect.
    -->
    <LangVersion>14</LangVersion>
    <!-- Generate packages.lock.json per project so dependency scanners (Aikido, Snyk) see exact resolved versions. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
