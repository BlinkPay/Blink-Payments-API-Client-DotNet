<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo><!-- setting GenerateAssemblyInfo to false causes this bug https://github.com/dotnet/project-system/issues/3934 -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>BlinkDebitApiClient</AssemblyName>
    <PackageId>BlinkDebitApiClient</PackageId>
    <OutputType>Library</OutputType>
    <Authors>Rey Vincent Babilonia (rey.babilonia@blinkpay.co.nz)</Authors>
    <Company>BlinkPay</Company>
    <AssemblyTitle>Blink Debit API Client for .NET</AssemblyTitle>
    <Description>Blink Debit API Client for .NET 8 and .NET 10</Description>
    <Copyright>Copyright (c) 2023 BlinkPay</Copyright>
    <RootNamespace>BlinkDebitApiClient</RootNamespace>
    <Version>1.8.1</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\BlinkDebitApiClient.xml</DocumentationFile>
    <RepositoryUrl>https://github.com/BlinkPay/Blink-Debit-API-Client-DotNet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Nullable>annotations</Nullable>
    <PackageProjectUrl>https://github.com/BlinkPay/Blink-Debit-API-Client-DotNet</PackageProjectUrl>
    <PackageIcon>blinkpay.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSubTypes" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\images\blinkpay.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>blinkpay.png</Link>
    </None>
  </ItemGroup>
</Project>
